   "source": [
    "#Dot product \n",
    "#normul python without using numpy \n",
    "x = [2,4,3]\n",
    "w = [0.5,0.2,-0.4]\n",
    "\n",
    "result = 0\n",
    "for i in range(len(x)):\n",
    "    result += x[i] * w[i]\n",
    "print(result)"
   ]
  },
